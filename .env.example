# GEMINI_API_KEY: Required for Gemini AI API calls (summarization, draft generation, email triage).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# GOOGLE_CLIENT_ID: Google Cloud OAuth 2.0 Client ID for Gmail API access.
GOOGLE_CLIENT_ID=""

# GOOGLE_CLIENT_SECRET: Google Cloud OAuth 2.0 Client Secret.
GOOGLE_CLIENT_SECRET=""

# GOOGLE_REDIRECT_URI: OAuth callback endpoint (e.g., https://your-domain.com/api/auth/callback/google)
GOOGLE_REDIRECT_URI=""

# DATABASE_URL: Persistent connection string or Supabase URL.
DATABASE_URL=""

# SUPABASE_URL: Supabase project API URL (e.g. https://your-project.supabase.co).
SUPABASE_URL=""

# SUPABASE_ANON_KEY: Supabase Public Anonymous API Key for client/RLS queries.
SUPABASE_ANON_KEY=""

# SUPABASE_SERVICE_ROLE_KEY: Supabase Server-side Service Role Key for backend administration.
SUPABASE_SERVICE_ROLE_KEY=""

